{
  "name": "maiajscompiler",
  "version": "1.1.0",
  "description": "MaiaJS (WebJS): ES8 JavaScript to WebAssembly compiler via C++ transpilation.",
  "author": "The MaiaScript Team (https://www.maiascript.com)",
  "license": "Apache-2.0",
  "main": "compiler/ecmascript-compiler.js",
  "bin": {
    "webjs": "bin/webjs.sh"
  },
  "files": [
    "bin/webjs.sh",
    "compiler/ecmascript-compiler.js",
    "compiler/ecmascript-parser.js",
    "compiler/parse-tree-collector.js",
    "grammar/EcmaScript.ebnf",
    "grammar/EcmaScript.xml",
    "docs/ECMAScript_Compiler_Architecture.md",
    "docs/ECMAScript_Compiler_Roadmap.md",
    "docs/Maia_Ecosystem_Synchronization_Protocol.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test compiler/tests/*.test.js",
    "test:fixtures": "node compiler/tests/run_fixtures.js",
    "test:suite:build": "bash compiler/examples/suite/build_all.sh",
    "test:suite:run": "bash compiler/examples/suite/run_all.sh",
    "test:course": "bash compiler/examples/programming_in_javascript_course_en/run_all.sh",
    "test:dist": "bash compiler/examples/build_test_dist.sh",
    "test:browser:es8": "bash compiler/examples/validate_full_es8_browser.sh",
    "test:browser:async": "bash compiler/examples/validate_async_state_machine_browser.sh",
    "test:browser:async-locals": "bash compiler/examples/validate_async_locals_browser.sh",
    "test:async:locals": "bash compiler/examples/validate_async_locals_dist.sh",
    "test:async:await-result": "bash compiler/examples/validate_async_await_result_dist.sh",
    "test:async:dynamic-value": "bash compiler/examples/validate_async_dynamic_value_dist.sh",
    "test:async:while-loop": "bash compiler/examples/validate_async_while_loop_dist.sh",
    "test:async:while-break": "bash compiler/examples/validate_async_while_break_dist.sh",
    "test:async:while-continue": "bash compiler/examples/validate_async_while_continue_dist.sh",
    "test:async:if-else-await": "bash compiler/examples/validate_async_if_else_await_dist.sh",
    "test:async:rejection": "bash compiler/examples/validate_async_rejection_dist.sh",
    "test:async:rejection-finally": "bash compiler/examples/validate_async_rejection_finally_dist.sh",
    "test:async:nested-rejection": "bash compiler/examples/validate_async_nested_rejection_dist.sh",
    "test:async:catch-finally": "bash compiler/examples/validate_async_catch_finally_dist.sh",
    "test:async:if-guard": "bash compiler/examples/validate_async_if_guard_dist.sh",
    "test:async:concurrent-rejections": "bash compiler/examples/validate_async_concurrent_rejections_dist.sh",
    "test:es8:promise-object": "bash compiler/examples/validate_es8_promise_object_computed.sh",
    "test:browser:promise-object": "bash compiler/examples/validate_es8_promise_object_browser.sh",
    "test:full": "npm run test && npm run test:suite:build && npm run test:suite:run && npm run test:course && npm run test:dist",
    "build:parser": "bash compiler/build.sh",
    "compile": "bin/webjs.sh",
    "dist:es8": "bash compiler/examples/build_test_dist.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/souzamonteiro/maiajs.git"
  },
  "bugs": {
    "url": "https://github.com/souzamonteiro/maiajs/issues"
  },
  "homepage": "https://github.com/souzamonteiro/maiajs#readme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "javascript",
    "compiler",
    "transpiler",
    "webassembly",
    "wasm",
    "es8",
    "ecmascript",
    "maiascript",
    "maia"
  ]
}
